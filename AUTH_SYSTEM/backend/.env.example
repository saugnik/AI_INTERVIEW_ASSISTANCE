# =============================================================================
# AI Interview Coach — AUTH backend (Google OAuth server, port 3002)
# -----------------------------------------------------------------------------
# Copy to `.env` in this directory:  cp .env.example .env
# =============================================================================

# Port the auth server listens on (frontend expects 3002 by default).
PORT=3002

# Google OAuth credentials — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback

# Where to send the user back after login (the Vite frontend).
FRONTEND_ORIGIN=http://localhost:5173

# Same Postgres database as the main API (used for admin codes / users).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
