# =============================================================================
# AI Interview Coach — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env`  (backend / Prisma read `.env`) and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored; THIS file (.env.example) is committed — keep it free of
# real secrets. Prisma CLI only reads `.env`, so DATABASE_URL must live there.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- AI: Groq (REQUIRED for question generation & evaluation) ----------------
# https://console.groq.com/keys — GROQ_API_KEY is the fallback for the two below.
GROQ_API_KEY=
GROQ_GENERATION_KEY=
GROQ_EVALUATION_KEY=

# --- AI: Gemini (optional / legacy) ------------------------------------------
GEMINI_API_KEY=

# --- Avatar video explanations (optional; NOT used by current code path) ------
HEYGEN_API_KEY=
DID_API_KEY=

# --- Access control (optional) -----------------------------------------------
ADMIN_EMAILS=

# --- Server (optional) -------------------------------------------------------
PORT=3001
NODE_ENV=development
# START_SERVER=false

# --- Frontend base URLs (optional; localhost defaults) -----------------------
VITE_BACKEND_URL=http://localhost:3001
VITE_AUTH_BACKEND_URL=http://localhost:3002
